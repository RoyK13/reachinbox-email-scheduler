# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# ─── Infrastructure (docker compose) ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails
# Elastic Cloud only: API key (base64 "id:key"). Leave unset for local Docker ES.
# ELASTICSEARCH_API_KEY=

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_me_with_a_long_random_string
# 32 random bytes, base64. Encrypts Slack tokens + SMTP passwords at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace_me_with_32_bytes_base64

# ─── Google OAuth (https://console.cloud.google.com/apis/credentials) ────────
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ─── Slack OAuth (https://api.slack.com/apps) ────────────────────────────────
SLACK_CLIENT_ID=replace_me
SLACK_CLIENT_SECRET=replace_me
# Slack requires https redirect URLs: use a tunnel, e.g. https://<id>.ngrok-free.app/api/slack/callback
SLACK_REDIRECT_URI=https://replace-me.ngrok-free.app/api/slack/callback

# ─── Sending / throttling ────────────────────────────────────────────────────
WORKER_CONCURRENCY=10
# Floor for delay between two sends from the same sender (per-request delay can only be higher).
MIN_EMAIL_DELAY_MS=2000
# Ceiling for the per-request hourly limit, per sender.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_RECIPIENTS_PER_REQUEST=10000
# SENDING rows older than this at worker startup are marked FAILED (outcome unknown).
SENDING_STALE_MS=300000

# ─── Queue / dashboard ───────────────────────────────────────────────────────
QUEUE_NAME=email-send
BULL_BOARD_ENABLED=true

# ─── Ethereal SMTP senders (create with: npm run ethereal:create) ────────────
# JSON array, one object per sender: name, email, user, pass [, host, port, secure]
ETHEREAL_SENDERS_JSON=[{"name":"Sender A","email":"sender.a@ethereal.email","user":"sender.a@ethereal.email","pass":"replace_me"},{"name":"Sender B","email":"sender.b@ethereal.email","user":"sender.b@ethereal.email","pass":"replace_me"}]
