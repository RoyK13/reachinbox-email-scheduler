# Used only by Vitest (tests/setup-env.ts). Contains NO real credentials —
# every value below is a fake placeholder. Points at isolated test resources:
# separate Postgres database, Redis logical DB 1, separate ES index + queue name.
NODE_ENV=test
PORT=4001
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=silent

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox_test
REDIS_URL=redis://localhost:6379/1
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails_test

SESSION_SECRET=test-session-secret-not-for-production
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test-google-secret
GOOGLE_CALLBACK_URL=http://localhost:4001/api/auth/google/callback

SLACK_CLIENT_ID=test-slack-client
SLACK_CLIENT_SECRET=test-slack-secret
SLACK_REDIRECT_URI=https://example.test/api/slack/callback

WORKER_CONCURRENCY=10
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_RECIPIENTS_PER_REQUEST=10000
SENDING_STALE_MS=300000

QUEUE_NAME=email-send-test
BULL_BOARD_ENABLED=true

ETHEREAL_SENDERS_JSON=[{"name":"Test Sender A","email":"test.a@ethereal.email","user":"test.a@ethereal.email","pass":"test-pass-a"},{"name":"Test Sender B","email":"test.b@ethereal.email","user":"test.b@ethereal.email","pass":"test-pass-b"}]
